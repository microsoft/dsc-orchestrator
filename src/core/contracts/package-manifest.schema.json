{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DSC Orchestrator package manifest",
  "description": "Root manifest.json contract for a built package ZIP.",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "version",
    "configurationHash",
    "target",
    "runtime",
    "resourceModules",
    "agentModules",
    "fragments"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "configurationHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "type": "string",
          "const": "windows"
        },
        "architecture": {
          "type": "string",
          "const": "x64"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "dscVersion",
        "powerShellVersion"
      ],
      "properties": {
        "dscVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "powerShellVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "resourceModules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
          }
        },
        "additionalProperties": false
      }
    },
    "agentModules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "resourceCount",
          "resources"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "path": {
            "type": "string",
            "pattern": "^configs/[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._-]{0,63}[.]dsc[.]yaml$"
          },
          "resourceCount": {
            "type": "integer",
            "minimum": 0
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "requiresRuntimeCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fragmentDependencyGate"
        ]
      }
    }
  },
  "additionalProperties": false
}
